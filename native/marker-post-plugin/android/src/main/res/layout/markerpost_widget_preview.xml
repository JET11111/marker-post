<?xml version="1.0" encoding="utf-8"?>
<!--
  What the widget picker shows (Android 12 and later): the widget with a
  sample post. Kept apart from the real layout so that sample text can never
  appear on a home screen. Older versions show the app icon in the picker.
  The same arrangement as markerpost_widget.xml: keep the two in step.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/markerpost_widget_background"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/markerpost_badge_motorway"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:paddingStart="7dp"
            android:paddingTop="3dp"
            android:paddingEnd="7dp"
            android:paddingBottom="3dp"
            android:text="@string/markerpost_preview_road"
            android:textColor="@color/markerpost_on_motorway"
            android:textSize="15sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:autoSizeMaxTextSize="64sp"
                android:autoSizeMinTextSize="16sp"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:fontFamily="sans-serif-black"
                android:fontFeatureSettings="tnum"
                android:gravity="start|center_vertical"
                android:includeFontPadding="false"
                android:letterSpacing="-0.03"
                android:maxLines="1"
                android:text="@string/markerpost_preview_km"
                android:textColor="@color/markerpost_text"
                android:textSize="28sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/markerpost_chip_filled"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:minWidth="34dp"
                android:minHeight="36sp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/markerpost_preview_letter"
                android:textColor="@color/markerpost_on_amber"
                android:textSize="22sp" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="@string/markerpost_preview_context"
            android:textColor="@color/markerpost_text"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="3"
        android:text="@string/markerpost_preview_time"
        android:textColor="@color/markerpost_text_secondary"
        android:textSize="13sp" />

</LinearLayout>
