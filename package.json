{
  "name": "marker-post",
  "version": "2.0.0",
  "private": true,
  "description": "Nearest marker post for the Hampshire patch: installable web app plus iOS and Android shells.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "serve": "node scripts/serve.mjs",
    "build": "node scripts/build-web.mjs --target=pwa",
    "build:native": "node scripts/build-web.mjs --target=native && node scripts/build-native-data.mjs",
    "preview": "node scripts/build-web.mjs --target=pwa && node scripts/serve.mjs www",
    "cap:sync": "npm run build:native && npx cap sync",
    "cap:sync:android": "npm run build:native && npx cap sync android",
    "cap:sync:ios": "npm run build:native && npx cap sync ios",
    "android:debug": "npm run cap:sync:android && node scripts/gradle.mjs assembleDebug",
    "android:release": "npm run cap:sync:android && node scripts/gradle.mjs assembleRelease",
    "android:test": "node scripts/build-native-data.mjs && node scripts/gradle.mjs testDebugUnitTest",
    "screenshots": "node scripts/screenshots.mjs",
    "basemap": "node scripts/fetch-basemap.mjs",
    "vendor": "node scripts/vendor.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/geolocation": "^8.2.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/splash-screen": "^8.0.2",
    "marker-post-native": "file:native/marker-post-plugin"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2",
    "@protomaps/basemaps": "5.7.2",
    "maplibre-gl": "6.19.0",
    "pmtiles": "4.5.0"
  }
}
